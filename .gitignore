.DS_Store
# Local dogfooding evidence and trace summaries stay private unless converted
# into a reviewed, redacted public example under docs/examples/missions/.
.hyperagent-evidence/
.workflow/
# Root-anchored on purpose: the private v1 evidence dir is `/missions/` only.
# An unanchored `missions/` also matches `src/missions/`, which would silently
# untrack the v2 mission-generation source (DAN-201).
/missions/

# v2 (Bun) toolchain
node_modules/
# Stray MCP server logs some agent harnesses write into the working directory.
logs/
